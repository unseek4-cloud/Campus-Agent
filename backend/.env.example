DB_URL=jdbc:mysql://localhost:3306/campus_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=campus_agent
DB_PASSWORD=replace-me
SERVER_PORT=8080
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_RAG_TIMEOUT_SECONDS=90
KNOWLEDGE_DEFAULT_TOP_K=5
KNOWLEDGE_MAX_TOP_K=20
# Optional service-guide AI wait budget; timeout returns the database workflow.
SERVICE_GUIDE_AI_TIMEOUT_SECONDS=12

# Required: Base64 of at least 32 cryptographically random bytes. See docs/auth-rbac.md.
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
# MUST be true behind production HTTPS. false supports local HTTP development.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared file size limit for knowledge documents and material templates (1-100 MB).
ADMIN_MAX_UPLOAD_SIZE_MB=20
ADMIN_DOCUMENT_STORAGE_PATH=var/documents
# Optional override; defaults to ADMIN_DOCUMENT_STORAGE_PATH/materials.
# MATERIAL_UPLOAD_DIR=var/documents/materials
